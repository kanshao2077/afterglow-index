{
  "name": "aigc-gallery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-catalog.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-catalog.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "ingest": "node scripts/ingest.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "sync": "node scripts/ingest.mjs && node scripts/build-catalog.mjs",
    "curate": "node scripts/curate.mjs",
    "test:catalog": "node --test tests/catalog.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {}
}
